{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/page" }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/advance.js": {
      "maxDuration": 300
    },
    "api/inbound.js": {
      "maxDuration": 300
    },
    "api/watch.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron?tick=early1",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron?tick=early2",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron?tick=early3",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron?tick=am",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron?tick=pm",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/watch?h=00",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/watch?h=01",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/watch?h=02",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/watch?h=03",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/watch?h=04",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/watch?h=05",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/watch?h=06",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/watch?h=07",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/watch?h=08",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/watch?h=09",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/watch?h=10",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/watch?h=11",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/watch?h=12",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/watch?h=13",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/watch?h=14",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/watch?h=15",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/watch?h=16",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/watch?h=17",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/watch?h=18",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/watch?h=19",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/watch?h=20",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/watch?h=21",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/watch?h=22",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/watch?h=23",
      "schedule": "30 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}

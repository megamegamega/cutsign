{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/page" },
    { "source": "/cards", "destination": "/api/page?view=cards" },
    { "source": "/actors", "destination": "/api/page?view=actors" },
    { "source": "/exposure", "destination": "/api/page?view=exposure" },
    { "source": "/exposure.json", "destination": "/api/page?view=exposure&format=json" },
    { "source": "/exposure.tsv", "destination": "/api/page?view=exposure&format=tsv" },
    { "source": "/actions", "destination": "/api/page?view=actions" },
    { "source": "/actions.json", "destination": "/api/page?view=actions&format=json" },
    { "source": "/actions.tsv", "destination": "/api/page?view=actions&format=tsv" },
    { "source": "/cards/:slug([a-z0-9-]+).pdf", "destination": "/api/pdf?slug=:slug" },
    { "source": "/cards/:slug([a-z0-9-]+)", "destination": "/api/page?view=card&slug=:slug" }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/advance.js": {
      "maxDuration": 300
    },
    "api/inbound.js": {
      "maxDuration": 300
    },
    "api/watch.js": {
      "maxDuration": 300
    },
    "api/pdf.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "crons": [
    {
      "path": "/api/selfcheck",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/cron?tick=early1",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron?tick=early2",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron?tick=early3",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron?tick=am",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron?tick=pm",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/watch?h=14",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/watch?h=15",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/watch?h=16",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/watch?h=17",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/watch?h=18",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/watch?h=19",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/watch?h=20",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/watch?h=21",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/watch?h=22",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/watch?h=23",
      "schedule": "30 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}

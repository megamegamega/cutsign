{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron.js": { "maxDuration": 300 },
    "api/advance.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron?tick=am", "schedule": "0 13 * * *" },
    { "path": "/api/cron?tick=pm", "schedule": "0 17 * * *" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}

# Names only. Real values go in .env (gitignored) for local runs, and in Vercel → Settings →
# Environment Variables for production (you can paste a whole .env file there).

# --- required ---
CRON_SECRET=               # random; Vercel cron sends it as a Bearer token. `openssl rand -hex 32`
SUPABASE_URL=
SUPABASE_SERVICE_KEY=      # service_role key — server only, never in a browser
ANTHROPIC_API_KEY=
EMAIL_API_KEY=             # Resend API key — FULL access (sends the digest AND reads received mail)
DISCORD_WEBHOOK_URL=
BRIEF_INBOUND_ADDRESS=     # Resend receiving address the brief is forwarded to (not secret)

# --- only if INBOUND_SOURCE=gmail ---
GMAIL_CLIENT_ID=           # Google Cloud OAuth client, type "Desktop app"
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=       # set by `npm run gmail-auth`

# --- optional (defaults shown) ---
INBOUND_SOURCE=            # resend (default) | gmail
BRIEF_SENDER_ALLOWLIST=    # REQUIRED: comma-separated sender addresses of the brief; nothing is accepted without it
GMAIL_QUERY=               # subject:"Threat Brief" newer_than:3d   (add from:(…) for your sender)
EMAIL_FROM=                # REQUIRED: Cutsign <cutsign@your-resend-verified-domain>
EMAIL_TO=                  # REQUIRED: where the daily brief goes
EMAIL_REPLY_TO=            # defaults to EMAIL_TO
MAX_STORIES=               # 4   most stories given the DEEP read (picked by score after the light read)
MIN_DEEP_SCORE=            # 6   minimum score for a deep read (see lib/select.js)
MAX_SOURCES=               # 40  pages fetched per brief
WATCH_MAX_DEEP_PER_DAY=    # 2   deep-tier re-reads triggered by watch changes, per day
WATCH_ALERT_MAIL=          # major  which HIGH watch events send a mail: major (KEV, exploitation, fix, starred PoC) | all | off
WATCH_MIN_INTERVAL_H=      # 18  a watch is read (pages, feeds, model on a change) once per daily block of ticks; keep it between 11 and 22 (longer than the block, shorter than a day), or 0 = every tick
WATCH_SLOW_GAP_MS=         # 7000 spacing of the keyless NVD/GitHub requests on watches not being read
MAX_MONTHLY_USD=           # 25  over this: still extracts, stops emailing, warns daily
PAUSED=                    # 1 halts the cron without a deploy
LLM_MODEL_DEEP=            # claude-sonnet-5-5 since 2026-11-12 (claude-opus-5-5 is twice the cost)
LLM_MODEL_LIGHT=           # claude-haiku-5-5
LLM_MODEL_PROPOSE=         # claude-sonnet-5-5 hunt-query proposer (2–4 calls/day; deep tier past 80% of the cap; claude-opus-5-5 until 2026-11-12, claude-fable-5-1 until 2026-11-04)
LLM_MODE=                  # live | record | replay
LLM_BATCH=                 # 1 (default): proposals and card drafts go through the Batches API at half price, collected on the watch ticks (needs migration 0007); 0 makes every call live
CARD_AUTOPUBLISH=          # 1 (default): an AI draft over HYPE_SURFACE is published at /cards/<slug>; 0 keeps drafts unpublished
HYPE_NOMINATE=             # 6   hype score that nominates a story thread to Discord
HYPE_SURFACE=              # 9   hype score that publishes its AI card (chip on the CISO view, agent JSON, email)
CARD_P1_PER_DAY=           # 3   P1 threads of one brief that get a card on day one whatever their score, in brief order; the others wait for HYPE_SURFACE
GITHUB_TOKEN=              # optional, read-only: lets the coverage check search SigmaHQ / Elastic / Splunk rule repos
PUBLIC_BASE_URL=           # defaults to the Vercel production URL
TOKEN_SECRET=              # v1: HMAC for pack/feedback links. `openssl rand -hex 32`
